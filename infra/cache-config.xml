<clickhouse>
  <!-- Connection to the main ClickHouse used by remote(main_ro, ...) in history queries,
       so credentials never appear in SQL text or query logs. -->
  <named_collections>
    <main_ro>
      <host>clickhouse-main</host>
      <port>9000</port>
      <user>chlive_ro</user>
      <password>chlive_ro</password>
      <database>default</database>
    </main_ro>
  </named_collections>
</clickhouse>
