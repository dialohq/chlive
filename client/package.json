{
  "name": "@chlive/client",
  "version": "0.1.0",
  "description": "Live ClickHouse query client for chlive (framework-agnostic) plus a React hook",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "wasm && bun --bun tsc -p tsconfig.json",
    "typecheck": "bun --bun tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
